<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sunum katmanı: WPF + WPF-UI (Fluent). View + ViewModel + DI kompozisyonu.
    Administrator manifesti ile başlar (WinDivert sürücüsü için gerekli).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>GoodbyeUI.App</RootNamespace>
    <AssemblyName>GoodbyeUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Self-contained tek dosya publish ayarları (publish sırasında -r ile birlikte kullanılır) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoodbyeUI.Core\GoodbyeUI.Core.csproj" />
    <ProjectReference Include="..\GoodbyeUI.Infrastructure\GoodbyeUI.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Tepsi/pencere ikonu XAML'den pack URI ile erişilebilsin. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
