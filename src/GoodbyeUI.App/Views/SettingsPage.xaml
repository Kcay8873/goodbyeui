<Page x:Class="GoodbyeUI.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="4,18,0,8" />
        </Style>
        <Style TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Loc[Settings_Title]}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />

            <!-- Görünüm -->
            <TextBlock Text="{Binding Loc[Settings_Appearance]}" Style="{StaticResource SectionHeader}" />

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Language]}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="200"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="NativeName" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Theme]}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="200"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </Grid>
            </ui:Card>

            <!-- Bağlantı -->
            <TextBlock Text="{Binding Loc[Settings_Connection]}" Style="{StaticResource SectionHeader}" />

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings_Preset]}" />
                        <TextBlock Text="{Binding Loc[Settings_Preset_Desc]}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings_CustomArgs]}" />
                    <TextBlock Text="{Binding Loc[Settings_CustomArgs_Desc]}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding CustomArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsCustomPresetSelected}"
                                PlaceholderText="-5 --set-ttl 5 --dns-addr 77.88.8.8 --dns-port 1253" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings_AutoConnect]}" />
                        <TextBlock Text="{Binding Loc[Settings_AutoConnect_Desc]}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding AutoConnectOnStartup, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings_MinimizeToTray]}" />
                        <TextBlock Text="{Binding Loc[Settings_MinimizeToTray_Desc]}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings_RunAtStartup]}" />
                        <TextBlock Text="{Binding Loc[Settings_RunAtStartup_Desc]}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <!-- Gelişmiş -->
            <TextBlock Text="{Binding Loc[Settings_Advanced]}" Style="{StaticResource SectionHeader}" />

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_LogLevel]}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="200"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
