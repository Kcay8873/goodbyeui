<Page x:Class="GoodbyeUI.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- Bağlıyken: glow (ışık) yoğunluğunun yumuşak nabzı -->
        <Storyboard x:Key="GlowPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.30" To="0.65" Duration="0:0:1.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Bağlanırken/kesilirken: dönen yay (spinner) -->
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.15" />
        </Storyboard>

        <!-- Dairesel bağlan butonu -->
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!-- Ana daire (düz renk) -->
                            <Ellipse x:Name="Fill" Fill="{Binding State, Converter={StaticResource StateToBrush}}" />

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.95" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.95" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">

            <!-- Bağlan halkası -->
            <Grid Width="300" Height="300" Margin="0,0,0,24">

                <!-- Katman 1: yumuşak GLOW (ışık yayan hale) — durum rengine göre -->
                <Ellipse x:Name="Glow" Width="220" Height="220"
                         Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                         Opacity="0.22">
                    <Ellipse.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian" />
                    </Ellipse.Effect>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="GlowPulse" Storyboard="{StaticResource GlowPulseStoryboard}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="GlowPulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Katman 2: dönen yay (yalnızca bağlanırken/kesilirken) -->
                <Ellipse x:Name="Spinner" Width="224" Height="224"
                         StrokeThickness="4"
                         Stroke="{Binding State, Converter={StaticResource StateToBrush}}"
                         StrokeDashArray="26 10" StrokeDashCap="Round"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="0" /></Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Opacity" Value="0.95" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Spin" Storyboard="{StaticResource SpinStoryboard}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Spin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Katman 3: buton -->
                <Button Width="168" Height="168"
                        Style="{StaticResource ConnectButtonStyle}"
                        Command="{Binding ToggleConnectionCommand}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Power24" FontSize="44" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ActionText}"
                                   Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Durum -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="10,0,0,0" FontSize="18" FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Profil seçimi -->
            <TextBlock Text="{Binding Loc[Home_PresetLabel]}" Opacity="0.7" Margin="4,0,0,6" />
            <ComboBox ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Padding="12,8">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </Grid>
</Page>
