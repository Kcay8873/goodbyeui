<Page x:Class="GoodbyeUI.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,24">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Loc[About_Title]}" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/Assets/app.ico"
                       Width="56" Height="56" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Loc[About_Version]}" Opacity="0.7" />
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding Version}" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Loc[About_Description]}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- Bağlantılar -->
            <TextBlock Text="{Binding Loc[About_Links]}" FontSize="15" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="{Binding Loc[About_GitHub]}"
                           Icon="{ui:SymbolIcon Code24}"
                           Command="{Binding OpenGitHubCommand}"
                           Margin="0,0,10,0" />
                <ui:Button Icon="{ui:SymbolIcon Heart24}"
                           Appearance="Primary"
                           Command="{Binding OpenPatreonCommand}">
                    <!-- Arka plan pembe olduğundan yazı her temada siyah kalsın. -->
                    <TextBlock Text="{Binding Loc[About_Patreon]}" Foreground="Black" />
                </ui:Button>
            </StackPanel>

            <ui:Card Padding="16,12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[About_Credit]}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[About_License]}" Opacity="0.6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
